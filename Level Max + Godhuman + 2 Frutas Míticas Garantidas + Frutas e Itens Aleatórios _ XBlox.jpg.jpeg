            #xb-product-recommendations-region a.group.h-full.flex-col[href^="/product/"]::after { content: none; display: none; }
            .xb-product-main-panel > .absolute, .xb-product-side-panel > .absolute, .xb-product-payment-panel > .absolute { display: none; }
            .xb-product-main-panel > .select-none { max-width: min(550px, calc(100vw - 76px)); }
            .xb-product-info { min-width: 0; padding: 0; }
            .xb-product-info .text-primary { color: #76d0ff; }
            .xb-product-title { color: #eef4fc; font-size: 22px; line-height: 1.35; font-weight: 700; overflow-wrap: anywhere; }
            .xb-product-info > div:first-child > span { border-width: 1px; border-radius: 8px; font-weight: 600; box-shadow: none; }
