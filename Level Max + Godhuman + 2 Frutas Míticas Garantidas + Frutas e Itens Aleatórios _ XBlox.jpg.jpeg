            /* Checkout: apresentação local; comércio, sessão e pagamento mantidos. */
            .xb-checkout-form { color: #eef4fc; min-width: 0; }
            .xb-checkout-layout { align-items: start; }
            .xb-checkout-panel { min-width: 0; padding: 16px; border: 1px solid #2c415b; border-radius: 16px; background: #101a2a; box-shadow: none; }
            .xb-checkout-heading { margin: 0 0 16px; color: #eef4fc; font-size: 18px; line-height: 24px; font-weight: 700; }
            .xb-checkout-form label { color: #dcebf9; font-size: 14px; line-height: 20px; font-weight: 600; }
            .xb-checkout-form input, .xb-checkout-form select, .xb-checkout-form textarea { min-width: 0; min-height: 44px; border-color: #4e7194; border-radius: 10px; background: #0c1523; color: #eef4fc; font-size: 16px; line-height: 22px; }
            .xb-checkout-form input::placeholder { color: #aebed2; opacity: 1; }
            .xb-checkout-form .text-muted-foreground, .xb-checkout-note { color: #aebed2; }
            .xb-checkout-form .text-primary { color: #76d0ff; }
            .xb-checkout-form :is(a, button, input, select, textarea):focus-visible { outline: 2px solid #76d0ff; outline-offset: 3px; }
            .xb-checkout-form button { min-height: 44px; }
            .xb-checkout-note { margin-top: 4px; font-size: 12px; line-height: 18px; }
            .xb-checkout-total-row { gap: 12px; align-items: flex-start; }
            .xb-checkout-total-row > :first-child { min-width: 0; overflow-wrap: anywhere; font-size: 14px; line-height: 20px; }
            .xb-checkout-total-row > :last-child { flex-shrink: 0; max-width: 55%; color: #dcebf9; text-align: right; overflow-wrap: anywhere; font-size: 14px; line-height: 20px; }
