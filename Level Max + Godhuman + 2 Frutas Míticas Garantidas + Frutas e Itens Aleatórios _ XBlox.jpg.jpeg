            .xb-product-options-list { overscroll-behavior: contain; padding: 2px; }
            .xb-product-purchase-status { padding: 10px 12px; border-color: #314b66; background: #142438; color: #aebed2; font-size: 14px; line-height: 20px; text-align: left; }
            .xb-product-purchase-status button { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 8px; color: #8bd4fb; }
            .xb-product-buy, .xb-product-add { min-height: 48px; border-width: 1px; border-radius: 10px; font-size: 16px; font-weight: 700; box-shadow: none; transform: none !important; }
            .xb-product-add { background: transparent; border-color: #36536f; color: #dcebf9; }
            .xb-product-payment-panel { padding: 0; border-style: solid; }
            .xb-product-payment-content { display: block; }
            .xb-product-payment-methods { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; width: 100%; margin: 0; padding: 0; list-style: none; }
            .xb-product-payment-method { display: flex; align-items: center; gap: 8px; padding: 8px; border: 1px solid #2c415b; border-radius: 8px; background: #142438; color: #dcebf9; font-size: 13px; line-height: 18px; }
            .xb-product-payment-method img { flex-shrink: 0; }
            .xb-product-side .text-muted-foreground { color: #aebed2; }
            .xb-cart-dialog { position: fixed; inset: 0 0 0 auto; width: min(100vw, 600px); max-width: 600px; height: 100vh; height: 100dvh; max-height: 100dvh; padding: 16px; border-radius: 0; border-color: #2c415b; background: #101a2a; color: #eef4fc; display: flex; flex-direction: column; overflow: hidden; box-shadow: none; }
            .xb-cart-shell { flex: 1; min-height: 0; height: 100%; gap: 12px; }
            .xb-cart-main { display: flex; flex-direction: column; flex: 1; min-height: 0; gap: 12px; overflow: hidden; }
            .xb-cart-main > * + * { margin-top: 0 !important; }
            .xb-cart-heading { flex-shrink: 0; min-height: 44px; margin-bottom: 0; padding-right: 52px; }
            .xb-cart-list { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
            .xb-cart-list > div { min-width: 0; width: 100%; }
            .xb-cart-dialog .xb-cart-item { border-color: #2c415b; border-radius: 12px; background: #101a2a; }
            .xb-cart-dialog .xb-cart-title { display: block; min-width: 0; -webkit-line-clamp: unset; -webkit-box-orient: initial; max-height: none; overflow: visible; white-space: normal; overflow-wrap: anywhere; color: #eef4fc; font-size: 14px; line-height: 20px; font-weight: 600; }
            .xb-cart-dialog .xb-cart-unit-price { color: #76d0ff; font-size: 14px; line-height: 20px; }
            .xb-cart-unit-label { display: none; }
            .xb-cart-dialog .xb-cart-unit-label { display: inline; color: #aebed2; font-size: 12px; font-weight: 400; }
            .xb-cart-dialog .xb-cart-actions { gap: 12px; }
            .xb-cart-dialog .xb-cart-quantity { display: flex; position: static; width: 144px; height: 44px; border: 1px solid #36536f; border-radius: 10px; overflow: visible; }
            .xb-cart-dialog .xb-cart-quantity-button { position: static; inset: auto; width: 44px; min-width: 44px; height: 44px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: #bce8ff; }
            .xb-cart-dialog .xb-cart-quantity-input { flex: 1; min-width: 0; width: 54px; height: 44px; padding: 0; border: 0; border-radius: 0; font-size: 16px; line-height: 22px; }
            .xb-cart-dialog .xb-cart-remove { width: 44px; min-width: 44px; height: 44px; border: 1px solid #6a3d48; border-radius: 10px; background: transparent; color: #f4aaaa; }
