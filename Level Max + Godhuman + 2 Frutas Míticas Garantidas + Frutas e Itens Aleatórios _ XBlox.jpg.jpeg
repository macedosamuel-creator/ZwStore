            .xb-product-option-image { width: 64px; height: 36px; flex-shrink: 0; object-fit: cover; border-radius: 6px; }
            .xb-product-option-copy { min-width: 0; margin-left: 8px; padding: 4px 0; gap: 4px; }
            .xb-product-option-title { display: block; color: #eef4fc; font-size: 14px; line-height: 20px; font-weight: 600; white-space: normal; overflow-wrap: anywhere; }
            .xb-product-option-price { margin-right: 0; min-width: 0; }
