            .xb-cart-subtotal > span:first-child { min-width: 0; overflow-wrap: anywhere; }
            .xb-cart-subtotal > span:last-child { color: #76d0ff; font-size: 18px; line-height: 24px; font-weight: 700; text-align: right; white-space: nowrap; }
            .xb-cart-subtotal > .xb-cart-subtotal-unconfirmed { color: #aebed2 !important; font-size: 14px !important; }
            .xb-cart-fee-note { margin: 0; color: #aebed2; font-size: 12px; line-height: 18px; }
