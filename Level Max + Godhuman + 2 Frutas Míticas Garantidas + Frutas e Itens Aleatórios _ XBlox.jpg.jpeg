            .xb-hero-trust > span { background: transparent; border-color: transparent; box-shadow: none; color: #aebed2; font-weight: 500; }
            .xb-hero-categories { background: transparent; box-shadow: none; border-color: #263b54; }
            .xb-hero-categories > p { color: #aebed2; }
            main a.group.h-full.flex-col[href^="/product/"] { border-width: 1px; border-color: #2c415b; border-radius: 16px; background: #101a2a; background-image: none; color: #eef4fc; box-shadow: none !important; }
            main a.group.h-full.flex-col[href^="/product/"] > div:first-child { height: 3px; background: #45b9ed; background-image: none; }
            main a.group.h-full.flex-col[href^="/product/"] > div.relative > div.aspect-video > div { display: none; }
            main a.group.h-full.flex-col[href^="/product/"] > div:last-of-type { padding: 10px; gap: 8px; }
            main a.group.h-full.flex-col[href^="/product/"] h3 { color: #eef4fc; font-size: 14px; line-height: 1.4; font-weight: 700; }
            main a.group.h-full.flex-col[href^="/product/"] > div:last-of-type > div:last-of-type { min-height: 90px !important; padding-top: 8px; border-top: 1px solid #2a3c52; }
            main a.group.h-full.flex-col[href^="/product/"] .text-muted-foreground { color: #aebed2; }
            main a.group.h-full.flex-col[href^="/product/"] .text-primary { color: #76d0ff; filter: none; }
            main a.group.h-full.flex-col[href^="/product/"] .xb-product-delivery { position: absolute; left: 8px; top: 8px; z-index: 10; padding: 4px 8px; border: 1px solid #334c69; border-radius: 6px; background: #101a2a; color: #dcebf9; font-size: 12px; line-height: 16px; font-weight: 600; }
            main a.group.h-full.flex-col[href^="/product/"] .xb-product-discount { display: inline-flex; align-items: center; padding: 2px 6px; border: 1px solid #334c69; border-radius: 5px; background: #142438; color: #bce8ff; font-size: 11px; line-height: 16px; font-weight: 600; }
            main a.group.h-full.flex-col[href^="/product/"] .xb-product-availability { display: block; margin-top: 8px; color: #94d5b0; font-size: 12px; line-height: 16px; font-weight: 600; }
            main a.group.h-full.flex-col[href^="/product/"] .xb-product-unavailable { color: #f4aaaa; }
            main a.group.h-full.flex-col[href^="/product/"]::after { content: "Ver detalhes"; display: flex; align-items: center; justify-content: center; min-height: 32px; margin: 0 10px 10px; padding: 4px 8px; border: 1px solid #315774; border-radius: 8px; background: #142b40; color: #bce8ff; font-size: 12px; font-weight: 600; line-height: 18px; }
            main a.group.h-full.flex-col[href^="/product/"]:focus-visible { outline: 2px solid #7dd3fc; outline-offset: 3px; }
            .xb-hero-mobile-label { display: none; }
